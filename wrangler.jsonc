{
  // Only used by the Deploy-to-Cloudflare button. We deploy with `cf deploy` (cloudflare.config.ts); keep bindings in sync.
  "name": "cf-cost",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": { "TEMPLATE": "exploded" },
  // /try/render: 10 renders per minute per IP
  "ratelimits": [{ "name": "TRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
  // secrets: CF_BILLING_TOKEN, DASH_PASSWORD. Optional var CF_ACCOUNT_ID if the token sees several accounts.
}
